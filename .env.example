# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se sube al repositorio.

# Entorno: desarrollo | pruebas | produccion
APP_ENV=desarrollo

# Clave secreta larga y aleatoria. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base de datos de desarrollo (solo PostgreSQL 16, controlador psycopg 3)
DATABASE_URL=postgresql+psycopg://controlgastos:CLAVE@localhost:5432/controlgastos

# Base de datos de pruebas. ¡pytest la BORRA y la recrea en cada ejecución!
# Su nombre debe contener "prueba" para evitar borrar datos reales.
TEST_DATABASE_URL=postgresql+psycopg://controlgastos:CLAVE@localhost:5432/controlgastos_pruebas

# Dirección de escucha de Gunicorn (en producción, el socket Unix de Nginx)
GUNICORN_BIND=127.0.0.1:8000

# Variables de entorno de PRODUCCIÓN (VPS). Nunca subas el archivo .env al repositorio.
#
# Crear el archivo en el servidor (solo root lo modifica; la aplicación solo lo lee):
#   sudo install -m 640 -o root -g controlgastos /srv/controlgastos/deploy/.env.example /srv/controlgastos/.env
#   sudo nano /srv/controlgastos/.env

# Entorno: en el servidor siempre "produccion" (sin depuración y con HTTPS obligatorio)
APP_ENV=produccion

# Clave secreta de 64 caracteres. Genérala en el servidor y pégala aquí:
#   python3.11 -c "import secrets; print(secrets.token_hex(32))"
# Si la cambias, se cierran todas las sesiones abiertas.
SECRET_KEY=

# Base de datos del propio servidor. Cambia CLAVE por la contraseña del rol controlgastos
# (paso 5.2 de la guía). Usa solo letras y números para no romper la dirección.
DATABASE_URL=postgresql+psycopg://controlgastos:CLAVE@localhost:5432/controlgastos

# Gunicorn escucha en el socket Unix que usa Nginx (no lo cambies)
GUNICORN_BIND=unix:/run/controlgastos/gunicorn.sock
